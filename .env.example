# ------------------------------------------------------------
# HappyFoam – Umgebungsvariablen
# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# Ohne Werte läuft die Website im Demo-Modus (Mock-Produkte, keine E-Mails).
# ------------------------------------------------------------

# Öffentliche Adresse der Website (ohne Schrägstrich am Ende), z. B. https://happyfoam.org
NEXT_PUBLIC_SITE_URL=

# --- Shopify (Headless / Storefront API) ---------------------
# Shop-Domain, z. B. happyfoam.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Öffentlicher Storefront-Access-Token aus dem Headless-Kanal
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Optional: API-Version (Standard: 2026-07)
SHOPIFY_API_VERSION=

# --- E-Mail für Kontakt- und B2B-Formular (Resend) -----------
RESEND_API_KEY=
# Empfänger der Formular-Nachrichten ([KONTAKT_EMAIL])
CONTACT_EMAIL=
# Optional: Absender, muss in Resend verifiziert sein, z. B. "HappyFoam <hallo@happyfoam.org>"
MAIL_FROM=

# --- Newsletter mit Double-Opt-in (Brevo) ---------------------
NEWSLETTER_API_KEY=
# ID der Brevo-Kontaktliste
BREVO_LIST_ID=
# ID der Double-Opt-in-Bestätigungsvorlage in Brevo
BREVO_DOI_TEMPLATE_ID=

# --- Analytics (cookielos, Plausible) – zusätzlich in site.config.ts aktivieren ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
