# ------------------------------------------------------------
# HappyFoam – Umgebungsvariablen
# Lokal: diese Datei nach .env.local kopieren und Werte eintragen.
# Live (Cloudflare): Werte als Secrets hinterlegen, z. B. npx wrangler secret put STRIPE_SECRET_KEY
# Ohne Werte läuft die Website im Demo-Modus (keine Zahlungen, keine E-Mails).
# ------------------------------------------------------------

# Öffentliche Adresse der Website (ohne Schrägstrich am Ende). Standard: https://happyfoam.org
NEXT_PUBLIC_SITE_URL=

# --- Stripe (Bezahlung) --------------------------------------
# Dashboard → Entwickler → API-Schlüssel (Test: sk_test_/pk_test_, Live: sk_live_/pk_live_)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard → Entwickler → Webhooks → Endpunkt https://happyfoam.org/api/stripe/webhook (payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=

# --- E-Mail: Formulare + Bestellbestätigungen (Resend) --------
RESEND_API_KEY=
# Empfänger für Formulare und Bestell-Benachrichtigungen ([KONTAKT_EMAIL])
CONTACT_EMAIL=
# Absender, muss in Resend verifiziert sein, z. B. "HappyFoam <bestellung@happyfoam.org>"
MAIL_FROM=

# --- Newsletter mit Double-Opt-in (Brevo) ---------------------
NEWSLETTER_API_KEY=
# ID der Brevo-Kontaktliste
BREVO_LIST_ID=
# ID der Double-Opt-in-Bestätigungsvorlage in Brevo
BREVO_DOI_TEMPLATE_ID=

# --- Analytics (cookielos, Plausible) – zusätzlich in site.config.ts aktivieren ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
